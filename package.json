{
  "name": "licitacao-platform",
  "version": "1.0.0",
  "description": "Plataforma de monitoramento de licitações — PNCP + ComprasNet",
  "scripts": {
    "analise:smoke": "ts-node scripts/smokeAnaliseEdital.ts",
    "api": "ts-node src/api/server.ts",
    "build": "tsc",
    "clientes:importar-v22": "ts-node scripts/importarClientesV22.ts",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "dados:exportar": "ts-node scripts/exportarDados.ts",
    "dados:importar": "ts-node scripts/importarDados.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push:danger": "prisma db push",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio",
    "dev:api": "ts-node-dev --respawn --transpile-only src/api/server.ts",
    "dev:workers": "ts-node-dev --respawn --transpile-only src/workers/index.ts",
    "documentos:check-expirations": "ts-node scripts/checkDocumentExpirations.ts",
    "dump:importar": "ts-node scripts/importarDumpSupabase.ts",
    "empresas:backfill": "ts-node scripts/empresasBackfill.ts",
    "lint": "eslint src scripts tests",
    "matches:rebuild": "ts-node scripts/rebuildMatches.ts",
    "migrar:producao": "ts-node scripts/migrarProducao.ts",
    "postinstall": "prisma generate",
    "producao:backup": "ts-node scripts/exportarSqlBruto.ts",
    "rawjson:enxugar": "ts-node scripts/enxugarRawJson.ts",
    "situacoes:refresh": "ts-node scripts/refreshSituacoes.ts",
    "start": "node dist/entrypoint.js",
    "start:api": "node dist/api/server.js",
    "start:workers": "node dist/workers/index.js",
    "tenders:backfill-norm": "ts-node scripts/backfillNormColumns.ts",
    "tenders:cleanup": "ts-node scripts/cleanupOldTenders.ts",
    "test": "vitest run",
    "test:e2e": "cross-env RATE_LIMIT_DISABLED=true start-server-and-test api http://localhost:3333/api/health cypress:run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "workers": "ts-node src/workers/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.17.1",
    "@prisma/client": "^5.14.0",
    "axios": "^1.7.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.8.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "resend": "^3.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "cross-env": "^10.1.0",
    "cypress": "^13.13.0",
    "eslint": "^10.10.0",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "prisma": "^5.14.0",
    "start-server-and-test": "^2.0.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
